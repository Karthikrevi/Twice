PORT=4000
DATABASE_URL=postgres://once:once@localhost:5432/once
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-too
ENCRYPTION_KEY=64-hex-char-aes-256-key-here-replace-replace-replace-replace-r
SENTRY_DSN=
# When true, integration calls hit api-sandbox.* hosts. Set false for prod.
PLATFORM_SANDBOX=true
TALABAT_WEBHOOK_SECRET=dev-talabat
DELIVEROO_WEBHOOK_SECRET=dev-deliveroo
INSTASHOP_WEBHOOK_SECRET=dev-instashop
# Data retention (UAE PDPL + FTA-aligned defaults; per-restaurant overrides
# live in the data_retention_config table).
DATA_RETENTION_ORDER_DAYS=730
DATA_RETENTION_SESSION_DAYS=365
DATA_RETENTION_AUDIT_DAYS=1095
